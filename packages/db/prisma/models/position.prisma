enum PositionSide {
  LONG
  SHORT
}

model Position {
  id             String       @id @default(uuid())

  userId         String
  marketId       String

  side           PositionSide

  quantity       Decimal      @default(0) @db.Decimal(30,10)
  avgEntryPrice  Decimal      @default(0) @db.Decimal(30,10)
  realizedPnl    Decimal      @default(0) @db.Decimal(30,10)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  market Market @relation(fields: [marketId], references: [id])

  @@unique([userId, marketId, side])
  @@index([userId])
  @@index([marketId])
}