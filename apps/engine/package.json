{
  "name": "engine",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "cd ../.. && bun --watch --env-file apps/server/.env apps/engine/v1/index.ts",
    "dev:v2": "cd v2 && cargo run",
    "start": "cd ../.. && bun --env-file apps/server/.env apps/engine/v1/index.ts",
    "start:v2": "cd v2 && cargo run --release",
    "test:v2": "cd v2 && cargo test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@repo/config": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/events": "workspace:*",
    "@repo/kafka": "workspace:*",
    "decimal.js": "^10.6.0"
  }
}
