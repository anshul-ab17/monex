enum MarketType {
  SPOT
  PREDICTION
  PERPETUAL
}

model Market {
  id              String      @id @default(uuid())
  symbol          String      @unique
  name            String
  type            MarketType
  baseAssetId     String
  quoteAssetId    String

  tickSize        Decimal     @db.Decimal(30,10)
  stepSize        Decimal     @db.Decimal(30,10)
  minOrderSize    Decimal     @db.Decimal(30,10)

  makerFee        Decimal     @default(0.0010) @db.Decimal(10,6)
  takerFee        Decimal     @default(0.0020) @db.Decimal(10,6)

  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  baseAsset       Asset @relation("BaseAsset", fields: [baseAssetId], references: [id])
  quoteAsset      Asset @relation("QuoteAsset", fields: [quoteAssetId], references: [id])

  orders          Order[]
  trades          Trade[]
  positions       Position[]
  outcomes        Outcome[]
  candles         Candle[]

  @@index([type])
}