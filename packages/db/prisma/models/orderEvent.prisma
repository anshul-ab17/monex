enum OrderEventType {
  PLACED
  PARTIALLY_FILLED
  FILLED
  CANCELLED
  EXPIRED
  REJECTED
  UPDATED
}

model OrderEvent {
  id String @id @default(uuid())
  orderId String
  
  eventType    OrderEventType
  eventOffset  BigInt?

  filledQty Decimal? @db.Decimal(30,10)
  remainingQty Decimal? @db.Decimal(30,10)
  price Decimal? @db.Decimal(30,10)
  reason String?

  createdAt DateTime @default(now())
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([eventType])
}