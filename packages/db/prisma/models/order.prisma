enum OrderSide {
  BUY
  SELL
}

enum OrderType {
  LIMIT
  MARKET
  IOC
  FOK
  POST_ONLY
  REDUCE_ONLY
}

enum OrderStatus {
  PENDING
  OPEN
  PARTIALLY_FILLED
  FILLED
  CANCELLED
  REJECTED
}


model Order {
  id            String      @id @default(uuid())
  userId        String
  marketId      String
  clientOrderId String?
  side          OrderSide
  type          OrderType
  status        OrderStatus @default(OPEN)
  
  sequenceNumber BigInt     @unique
  price         Decimal?    @db.Decimal(30,10)
  quantity      Decimal     @db.Decimal(30,10)
  filledQty     Decimal     @default(0) @db.Decimal(30,10)

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  events        OrderEvent[]

  buyTrades     Trade[] @relation("BuyOrder")
  sellTrades    Trade[] @relation("SellOrder")

  user   User   @relation(fields: [userId], references: [id])
  market Market @relation(fields: [marketId], references: [id])

  @@index([userId])
  @@index([marketId])
  @@index([marketId, status])
  @@unique([userId, clientOrderId])
}