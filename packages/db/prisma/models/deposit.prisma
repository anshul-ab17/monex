enum DepositStatus {
  PENDING
  CONFIRMED
  FAILED
}

model Deposit {
  id        String        @id @default(cuid())
  userId    String
  assetId   String

  txHash    String        @unique

  amount    Decimal       @db.Decimal(30,10)

  status    DepositStatus

  createdAt DateTime      @default(now())

  asset Asset @relation(fields: [assetId], references: [id])

  @@index([userId])
  @@index([txHash])
}