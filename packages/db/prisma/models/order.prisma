enum OrderSide {
  BUY
  SELL
}

enum OrderType {
  LIMIT
  MARKET
  STOP_LIMIT
  STOP_MARKET
}

enum TimeInForce {
  GTC
  IOC
  FOK
}

enum OrderStatus {
  PENDING
  OPEN
  PARTIALLY_FILLED
  FILLED
  CANCELLED
  EXPIRED
  REJECTED
}


model Order {
  id            String      @id @default(uuid())
  userId        String
  marketId      String
  clientOrderId String? @unique
  side          OrderSide
  type          OrderType
  status        OrderStatus @default(OPEN)
  
  sequenceNumber BigInt     @unique
  price         Decimal?    @db.Decimal(30,10)
  stopPrice     Decimal?    @db.Decimal(30,10)
  quantity      Decimal     @db.Decimal(30,10)
  remainingQty  Decimal     @db.Decimal(30,10)
  filledQty     Decimal     @default(0) @db.Decimal(30,10)

  cancelledAt   DateTime?
  expiresAt     DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  events        OrderEvent[]

  timeInForce TimeInForce @default(GTC)
  postOnly Boolean @default(false)
  reduceOnly Boolean @default(false)

  buyTrades     Trade[] @relation("BuyOrder")
  sellTrades    Trade[] @relation("SellOrder")

  user   User   @relation(fields: [userId], references: [id])
  market Market @relation(fields: [marketId], references: [id])

  @@index([userId])
  @@index([marketId])
  @@index([marketId, status])
}